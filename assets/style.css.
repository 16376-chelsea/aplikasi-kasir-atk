* {
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 30px;
    background-color: #f4f6f9;
    color: #263445;
}

h1 {
    color: #1e3a5f;
    margin-bottom: 10px;
}

h2 {
    color: #1e3a5f;
}

p {
    line-height: 1.6;
}

nav {
    background-color: #1e3a5f;
    padding: 15px;
    border-radius: 8px;
    margin: 20px 0;
}

nav a {
    color: white;
    text-decoration: none;
    margin-right: 15px;
}

nav a:hover {
    text-decoration: underline;
}

input,
select {
    width: 100%;
    max-width: 450px;
    padding: 12px;
    margin-top: 6px;
    border: 1px solid #ccd3dc;
    border-radius: 6px;
    font-size: 14px;
}

button {
    padding: 11px 18px;
    background-color: #1e3a5f;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 10px;
}

button:hover {
    background-color: #28527f;
}

table {
    width: 100%;
    border-collapse: collapse;
    background-color: white;
}

th {
    background-color: #1e3a5f;
    color: white;
}

th,
td {
    padding: 12px;
    text-align: left;
    border: 1px solid #dce2e9;
}

tr:nth-child(even) {
    background-color: #f8fafc;
}

.login-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background-color: #eaf0f7;
}

.login-box {
    background-color: white;
    width: 100%;
    max-width: 380px;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.1);
}

.login-box h1,
.login-box > p {
    text-align: center;
}

.login-box label {
    display: block;
    margin-top: 15px;
}

.login-box input,
.login-box button {
    width: 100%;
}

@media (max-width: 600px) {
    body {
        padding: 16px;
    }

    nav a {
        display: inline-block;
        margin: 5px;
    }

    table {
        font-size: 12px;
    }

    th,
    td {
        padding: 7px;
    }
}

   

